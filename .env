NODE_ENV=production
PORT=10000
DATABASE_URL=postgresql://user:pass@host:5432/db
SESSION_SECRET=change_this_32_char_min_secret_key
ENCRYPTION_SECRET=32_character_encryption_key_12345

# Redis v9.0 - uncomment when ready
REDIS_URL=redis://default:pass@host:6379

# Cloudinary
CLOUDINARY_CLOUD=your_cloud_name
CLOUDINARY_KEY=your_key
CLOUDINARY_SECRET=your_secret

# Gmail
GMAIL_USER=your@gmail.com
GMAIL_PASS=your_app_password

# Africa's Talking
AT_USERNAME=sandbox
AT_API_KEY=your_key

# OpenAI
OPENAI_API_KEY=sk-your_key

# Sentry
SENTRY_DSN=https://your_dsn@sentry.io/project

# Payment Gateways
MTN_COLLECTION_USER_ID=
MTN_COLLECTION_API_KEY=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
FLUTTERWAVE_SECRET_KEY=

# App URLs
RENDER_EXTERNAL_URL=https://ssewasswa-api.onrender.com
FRONTEND_URL=https://ssewasswa.com
