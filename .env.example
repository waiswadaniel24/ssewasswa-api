# ssewasswa-api — .env.example
#
# Copy this file to .env and fill in the values for local development.
# NEVER commit the real .env file — it's in .gitignore.
#
# For production, set these via Render dashboard (or your hosting provider).
# See render.yaml for which env vars are sync:false (must be set manually)
# vs value: (committed to the repo because they're not secret).

# === Core app ===
NODE_ENV=development
BASE_URL=http://localhost:3000
APP_NAME=Comfort Zone

# === Database (REQUIRED) ===
# Local dev:
DATABASE_URL=postgres://localhost/ssewasswa_dev
# Production (Render):
# DATABASE_URL=postgresql://user:pass@host/dbname

# === Session & CSRF (REQUIRED) ===
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-64-char-random-hex-string
CSRF_SECRET=replace-me-with-a-different-64-char-random-hex-string

# === Encryption keys (REQUIRED for production) ===
# Used for field-level encryption (audit logs, PII, etc.)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-a-64-char-random-hex-string
# Separate key for PHI (patient data) — HIPAA compliance
# Generate with: openssl rand -hex 32
PHI_ENCRYPTION_KEY=replace-me-with-a-different-64-char-random-hex-string

# === KMS (Gap 8) — envelope encryption for PHI ===
# Provider: 'local' (dev — uses PHI_ENCRYPTION_KEY above) or 'aws' (production —
# uses AWS KMS; the master key never leaves KMS). See docs/KMS_SETUP.md.
KMS_PROVIDER=local
# AWS KMS (only required when KMS_PROVIDER=aws). Set to the KMS key ARN, e.g.
# arn:aws:kms:us-east-1:123456789012:key/abcd-1234-...
AWS_KMS_KEY_ID=
AWS_REGION=us-east-1
# AWS credentials are picked up from the standard credential provider chain:
#   1. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY env vars (set below if not on EC2/ECS)
#   2. ~/.aws/credentials file
#   3. IAM role attached to the compute (recommended on Render/EC2/ECS/EKS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# === Web Push (VAPID keys — REQUIRED for push notifications) ===
# Generate ONCE with: npx web-push generate-vapid-keys
# Do NOT regenerate — existing subscriptions will break.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === Stripe (Track B — overseas donations + card payments) ===
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Get from https://dashboard.stripe.com/webhooks (create an endpoint for /api/payments/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# === PayPal (Track B — alternative for overseas donors) ===
# Get from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# === Platform fee configuration (Track B) ===
# Percent of each transaction that goes to the platform (you)
PLATFORM_FEE_PERCENT_FUNDRAISING=0.5
PLATFORM_FEE_PERCENT_POS=3.0
PLATFORM_FEE_PERCENT_SCHOOL_FEES=1.0
PLATFORM_FEE_PERCENT_SUBSCRIPTION=0.0

# === Africa's Talking (SMS + USSD) ===
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=COMFORT

# === Mobile Money (Uganda) ===
# MTN MoMo Collection API — https://momodeveloper.mtn.com/
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
# Airtel Money Merchant API
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_MONEY_BASE_URL=https://openapiuat.airtel.africa

# === Other payment gateways ===
# Flutterwave — https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=
# DPO (Direct Pay Online) — https://www.dpodevelopers.com/
DPO_COMPANY_TOKEN=

# === Cloudinary (image/file storage) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or use the combined URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# === Google OAuth (SSO) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Email (SMTP) ===
# Any SMTP provider works (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Comfort Zone
SUPPORT_EMAIL=support@comfortzone.co.ug

# === Redis (optional — for caching and background jobs) ===
# REDIS_URL=redis://localhost:6379

# === Sentry (error monitoring) ===
# SENTRY_DSN=https://xxx@sentry.io/xxx

# === Google Analytics ===
GA_TRACKING_ID=G-XXXXXXXXXX

# === Google Search Console verification ===
GOOGLE_SITE_VERIFICATION=

# === Rate limiting (defaults are fine for most deployments) ===
# LOGIN_RATE_LIMIT=50
# API_RATE_LIMIT=100

# === Dev bypass (NEVER set in production) ===
# DEV_EMAIL=admin@local
# DEV_PASSWORD=dev-bypass
