<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon definition for Comfort Zone.
    
    Replace with your actual icon files:
    - ic_launcher_foreground.xml (your app icon)
    - ic_launcher_background.xml (background color)
    
    For quick setup, copy your PWA icon-192.png or icon-512.png here
    and reference it directly.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/splash_background" />
    <foreground>
        <inset
            android:drawable="@color/white"
            android:inset="30%" />
    </foreground>
</adaptive-icon>
