{
  "name": "ssewasswa-platform",
  "version": "9.0.0",
  "description": "Multi-portal platform: School, Org, Church, Business, Individual",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "worker": "node worker.js",
    "migrate": "node-pg-migrate up",
    "migrate:create": "node-pg-migrate create",
    "migrate:down": "node-pg-migrate down",
    "migrate:redo": "node-pg-migrate redo",
    "migrate:legacy": "node migrate.js",
    "test": "node --test test/*.test.js",
    "test:jest": "jest --maxWorkers=1",
    "lint": "eslint server.js --quiet || true",
    "syntax": "node -c server.js",
    "ci": "npm run syntax && npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1075.0",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@sentry/node": "^10.52.0",
    "africastalking": "^0.8.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.7.0",
    "cloudinary": "^2.2.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "lodash": "^4.18.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.5.0",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "rss-parser": "^3.13.0",
    "stripe": "^22.3.0",
    "web-push": "^3.6.7",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
